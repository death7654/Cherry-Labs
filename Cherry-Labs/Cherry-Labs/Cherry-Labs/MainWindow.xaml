<Window
    x:Class="Cherry_Labs.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cherry_Labs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="Cherry-Labs">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Main layout -->
    <Grid>
        <muxc:NavigationView PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Chat" Tag="chat" Icon="Library" IsSelected="True"/>
                <muxc:NavigationViewItem Content="Video" Tag="video" Icon="Video"/>
            </muxc:NavigationView.MenuItems>

            <!-- Main content area inside the nav view -->
            <Grid>
                <!-- Define layout rows -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <!-- Chat message list -->
                    <RowDefinition Height="Auto" />
                    <!-- Input row -->
                </Grid.RowDefinitions>

                <!-- Chat messages -->
                <ListView x:Name="ChatList" Margin="10" VerticalAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="WrapWholeWords" FontSize="16"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Chat input row -->
                <Grid Height="60" Margin="10,0,10,0" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <RichEditBox x:Name="ChatInput"
                 Grid.Column="0"
                 PlaceholderText="Enter your message..."
                 VerticalAlignment="Center"
                 Margin="0,0,0,0" />

                    <!-- Button: 20% -->
                    <Button Grid.Column="1"
                            Content="➤"
                            Height="33"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Click="SendButton_Click"
                            Margin="5,0,0,0"/>
                </Grid>

            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
